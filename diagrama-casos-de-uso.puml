@startuml
title Bolonha e Milano - Casos de uso (Etapa 3)
left to right direction
actor Jogador

rectangle "Bolonha e Milano" {
  usecase "Iniciar novo jogo" as UC1
  usecase "Ver status da cidade" as UC2
  usecase "Acessar mercado" as UC3
  usecase "Ver informacoes sobre o jogo" as UC4
  usecase "Sair do jogo" as UC5
  usecase "Comprar graos" as UC6
  usecase "Vender graos" as UC7
  usecase "Comprar terras" as UC8
  usecase "Vender terras" as UC9
}

Jogador --> UC1
Jogador --> UC2
Jogador --> UC3
Jogador --> UC4
Jogador --> UC5
UC6 .> UC3 : <<extend>>
UC7 .> UC3 : <<extend>>
UC8 .> UC3 : <<extend>>
UC9 .> UC3 : <<extend>>
@enduml

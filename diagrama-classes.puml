
@startuml
title Bolonha e Milano - Diagrama de Classes

skinparam classAttributeIconSize 0

class Main {
    +main(args: String[]): void
}

class Menu {
    -scanner: Scanner
    -emExecucao: boolean
    -jogador: Jogador
    -cidade: Cidade
    -mercado: Mercado
    -agricultura: Agricultura
    -governo: Governo

    +Menu()
    +executar(): void

    -exibirOpcoes(): void
    -lerOpcao(): int
    -processarOpcao(opcao: int): void
    -iniciarNovoJogo(): void
    -exibirStatus(): void
    -abrirMercado(): void
    -abrirAgricultura(): void
    -abrirGoverno(): void

    -lerNome(pergunta: String): String
    -lerQuantidade(): int

    -comprarGraos(): void
    -venderGraos(): void
    -comprarTerras(): void
    -venderTerras(): void

    -colher(): void
    -distribuirAlimentos(): void

    -arrecadarImpostos(): void
    -definirTaxaImposto(): void
    -definirJustica(): void

    -exibirSobre(): void
}

class Jogador {
    -nome: String
    -titulo: String

    +Jogador(nome: String)
    +getNome(): String
    +getTitulo(): String
    +setTitulo(titulo: String): void
}

class Cidade {
    -nome: String
    -anoAtual: int
    -dono: Jogador
    -florins: int
    -terras: int
    -graos: int
    -servos: int
    -taxaImposto: int
    -nivelJustica: String

    +Cidade(nome: String, dono: Jogador)

    +getNome(): String
    +getAnoAtual(): int
    +getDono(): Jogador

    +getFlorins(): int
    +getTerras(): int
    +getGraos(): int
    +getServos(): int

    +getTaxaImposto(): int
    +setTaxaImposto(taxa: int): void

    +getNivelJustica(): String
    +setNivelJustica(nivel: String): void

    +avancarAno(): void

    +adicionarFlorins(qtd: int): void
    +removerFlorins(qtd: int): boolean

    +adicionarTerras(qtd: int): void
    +removerTerras(qtd: int): boolean

    +adicionarGraos(qtd: int): void
    +removerGraos(qtd: int): boolean

    +adicionarServos(qtd: int): void
    +removerServos(qtd: int): boolean

    +exibirStatus(): void
}

class Mercado {
    -PRECO_GRAO: int
    -PRECO_TERRA: int

    +getPrecoGrao(): int
    +getPrecoTerra(): int

    +comprarGraos(c: Cidade, qtd: int): boolean
    +venderGraos(c: Cidade, qtd: int): boolean

    +comprarTerras(c: Cidade, qtd: int): boolean
    +venderTerras(c: Cidade, qtd: int): boolean
}

class Agricultura {
    -HECTARES_POR_SERVO: int
    -RENDIMENTO_POR_HECTARE: int
    -SERVOS_POR_GRAO: int
    -CRESCIMENTO_PERCENTUAL: int
    -PERCENTUAL_MINIMO: int
    -PERCENTUAL_MAXIMO: int

    +getPercentualMinimo(): int
    +getPercentualMaximo(): int

    +processarColheita(cidade: Cidade): int
    +distribuirAlimentos(cidade: Cidade, percentual: int): boolean
}

class Governo {
    -TAXA_MAXIMA: int
    -MULTIPLICADOR_JUSTA: double
    -MULTIPLICADOR_MODERADA: double
    -MULTIPLICADOR_SEVERA: double

    +arrecadarImpostos(cidade: Cidade): int
    +definirTaxaImposto(cidade: Cidade, taxa: int): boolean
    +definirJustica(cidade: Cidade, nivel: String): boolean

    -multiplicadorPara(nivel: String): double
}

Main ..> Menu : cria
Menu --> Jogador
Menu --> Cidade
Menu --> Mercado
Menu --> Agricultura
Menu --> Governo

Cidade --> Jogador : dono

Mercado ..> Cidade : utiliza
Agricultura ..> Cidade : utiliza
Governo ..> Cidade : utiliza

@enduml


@startuml
title Bolonha e Milano - Diagrama de Classes (Etapa 7)

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

class Main {
    +main(args: String[]): void
}

class Menu {
    -scanner: Scanner
    -emExecucao: boolean
    -partida: Partida
    -cidade: Cidade
    -mercado: Mercado
    -agricultura: Agricultura
    -governo: Governo
    -construcoes: Construcoes
    -nobreza: Nobreza

    +Menu()
    +executar(): void
    -exibirOpcoes(): void
    -lerOpcao(): int
    -processarOpcao(opcao: int): void
    -iniciarNovoJogo(): void
    -exibirStatus(): void
    -abrirMercado(): void
    -comprarGraos(): void
    -venderGraos(): void
    -comprarTerras(): void
    -venderTerras(): void
    -abrirAgricultura(): void
    -colher(): void
    -distribuirAlimentos(): void
    -abrirGoverno(): void
    -arrecadarImpostos(): void
    -definirTaxaImposto(): void
    -definirJustica(): void
    -abrirConstrucoes(): void
    -recrutarSoldados(): void
    -construir(): void
    -encerrarTurno(): void
    -exibirClassificacao(): void
    -encerrarPartida(): void
    -exibirSobre(): void
}

class Jogador {
    {static} -TITULOS: String[]
    -nome: String
    -nivelTitulo: int

    +Jogador(nome: String)
    +getNome(): String
    +getTitulo(): String
    +getNivelTitulo(): int
    +promover(): boolean
    +ehMonarca(): boolean
}

class Cidade {
    -nome: String
    -anoAtual: int
    -dono: Jogador
    -florins: int
    -terras: int
    -graos: int
    -servos: int
    -taxaImposto: int
    -nivelJustica: String
    -soldados: int
    -construcoes: int
    -colheitaFeita: boolean
    -impostosArrecadados: boolean

    +Cidade(nome: String, dono: Jogador)
    +getNome(): String
    +getAnoAtual(): int
    +getDono(): Jogador
    +getFlorins(): int
    +getTerras(): int
    +getGraos(): int
    +getServos(): int
    +getSoldados(): int
    +getConstrucoes(): int
    +getTaxaImposto(): int
    +setTaxaImposto(taxa: int): void
    +getNivelJustica(): String
    +setNivelJustica(nivel: String): void
    +avancarAno(): void
    +isColheitaFeita(): boolean
    +marcarColheitaFeita(): void
    +isImpostosArrecadados(): boolean
    +marcarImpostosArrecadados(): void
    +adicionarFlorins(qtd: int): void
    +removerFlorins(qtd: int): boolean
    +adicionarTerras(qtd: int): void
    +removerTerras(qtd: int): boolean
    +adicionarGraos(qtd: int): void
    +removerGraos(qtd: int): boolean
    +adicionarServos(qtd: int): void
    +removerServos(qtd: int): boolean
    +adicionarSoldados(qtd: int): void
    +removerSoldados(qtd: int): boolean
    +adicionarConstrucoes(qtd: int): void
    +removerConstrucoes(qtd: int): boolean
    +exibirStatus(): void
}

class Partida {
    {static} +MAXIMO_JOGADORES: int = 4
    {static} -ANO_FINAL: int = 1410
    -cidades: List<Cidade>
    -indiceAtual: int

    +Partida()
    +adicionarCidade(cidade: Cidade): boolean
    +getCidades(): List<Cidade>
    +getCidadeAtual(): Cidade
    +getAnoAtual(): int
    +getAnoFinal(): int
    +passarTurno(): boolean
    +encerrarAno(nobreza: Nobreza): List<Cidade>
    +terminou(): boolean
    +determinarVencedor(nobreza: Nobreza): Cidade
}

class Mercado {
    -PRECO_GRAO: int
    -PRECO_TERRA: int

    +getPrecoGrao(): int
    +getPrecoTerra(): int
    +comprarGraos(cidade: Cidade, quantidade: int): boolean
    +venderGraos(cidade: Cidade, quantidade: int): boolean
    +comprarTerras(cidade: Cidade, quantidade: int): boolean
    +venderTerras(cidade: Cidade, quantidade: int): boolean
}

class Agricultura {
    -HECTARES_POR_SERVO: int
    -RENDIMENTO_POR_HECTARE: int
    -SERVOS_POR_GRAO: int
    -CRESCIMENTO_PERCENTUAL: int
    -PERCENTUAL_MINIMO: int
    -PERCENTUAL_MAXIMO: int

    +processarColheita(cidade: Cidade): int
    +distribuirAlimentos(cidade: Cidade, percentual: int): boolean
    +getPercentualMinimo(): int
    +getPercentualMaximo(): int
}

class Governo {
    -TAXA_MAXIMA: int
    -MULTIPLICADOR_JUSTA: double
    -MULTIPLICADOR_MODERADA: double
    -MULTIPLICADOR_SEVERA: double

    +arrecadarImpostos(cidade: Cidade): int
    +definirTaxaImposto(cidade: Cidade, taxa: int): boolean
    +definirJustica(cidade: Cidade, nivel: String): boolean
    -multiplicadorPara(nivel: String): double
}

class Construcoes {
    -PRECO_SOLDADO: int
    -SERVOS_POR_SOLDADO: int
    -PRECO_CONSTRUCAO: int

    +recrutarSoldados(cidade: Cidade, quantidade: int): boolean
    +construir(cidade: Cidade, quantidade: int): boolean
    +getPrecoSoldado(): int
    +getPrecoConstrucao(): int
}

class Nobreza {
    -PESO_CONSTRUCAO: int = 10
    -PESO_SOLDADO: int = 2
    -PESO_SERVO: int = 1
    -HECTARES_POR_PONTO: int = 100
    -PRESTIGIO_MINIMO: int[]

    +calcularPrestigio(cidade: Cidade): int
    +prestigioParaProximoTitulo(jogador: Jogador): int
    +verificarPromocao(cidade: Cidade): boolean
}

Main ..> Menu : cria

Menu --> Partida : controla
Menu --> Cidade : cidade da vez
Menu --> Mercado : utiliza
Menu --> Agricultura : utiliza
Menu --> Governo : utiliza
Menu --> Construcoes : utiliza
Menu --> Nobreza : utiliza

Partida "1" o-- "1..4" Cidade : cidades
Cidade "1" --> "1" Jogador : dono

Mercado ..> Cidade : utiliza
Agricultura ..> Cidade : utiliza
Governo ..> Cidade : utiliza
Construcoes ..> Cidade : utiliza
Nobreza ..> Cidade : calcula prestígio
Nobreza ..> Jogador : promove
Partida ..> Nobreza : verifica promoções

note right of Partida
  Controla os turnos e os anos.
  Aceita de 1 a 4 cidades.
  O último jogador encerra o ano.
  A partida termina em 1410
  ou quando alguém vira monarca.
end note

note bottom of Cidade
  Colheita e arrecadação de impostos
  podem acontecer uma vez por ano.
  Os indicadores são zerados
  por avancarAno().
end note

note right of Nobreza
  Prestígio =
  construções * 10 +
  soldados * 2 +
  servos +
  terras / 100

  Promove no máximo um título
  por verificação.
end note

@enduml
